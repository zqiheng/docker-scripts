FROM swr.cn-southwest-2.myhuaweicloud.com/eric/zulujdk:jdk-8u432-fx-x86
WORKDIR /app

ENV JAVA_OPS=""

COPY ../server-packages/mycim-oms-foundation*.jar /app/app.jar
RUN mkdir -p /app/agent
COPY ../agent/transmittable-thread-local-2.14.2.jar /app/agent/transmittable-thread-local-2.14.2.jar

ENTRYPOINT ["sh","-c","java -javaagent:/app/agent/transmittable-thread-local-2.14.2.jar -Djava.security.egd=file:/dev/./urandom -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/app/heapdump.hprof -Dfile.encoding=utf-8 $JAVA_OPS -jar /app/app.jar"]
